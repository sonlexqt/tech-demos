@@ -0,0 +1,134 @@
+#!/usr/bin/env python3
+"""Assemble fixtures/demo.json — the offline view model the UI renders."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+F = ROOT / "fixtures"
+
+
+def score(hit_texts: list[str], hit_paths: list[str], key: dict) -> dict:
+    blob = "\n".join(hit_texts).lower()
+    needles = key["mustIncludeAny"]
+    needles_found = [n for n in needles if n.lower() in blob]
+    preferred = key.get("preferredFiles") or []
+    top = (hit_paths[0] if hit_paths else "") or ""
+    top_preferred = any(p.lower() in top.lower() for p in preferred)
+    any_preferred = any(any(p.lower() in (hp or "").lower() for p in preferred) for hp in hit_paths)
+    return {
+        "needlesFound": needles_found,
+        "needlesMissed": [n for n in needles if n not in needles_found],
+        "containsAnswer": bool(needles_found),
+        "topHitPreferred": top_preferred,
+        "anyPreferredFile": any_preferred,
+    }
+
+
+def rel_path(value: str | None) -> str:
+    if not value:
+        return ""
+    # ax_path may be absolute
+    marker = "/corpus/"
+    if marker in value:
+        return value.split(marker, 1)[1]
+    return value
+
+
+def main() -> None:
+    questions = json.loads((F / "questions.json").read_text())
+    answers = json.loads((F / "answers.json").read_text())
+    grep = json.loads((F / "grep-results.json").read_text())
+    es = json.loads((F / "xerj-es-passages.json").read_text())
+    cli = json.loads((F / "xerj-search.json").read_text())
+    gain = json.loads((F / "xerj-gain.json").read_text())
+    gain_text = (F / "xerj-gain.txt").read_text()
+    meta = json.loads((F / "capture-meta.json").read_text())
+
+    items = []
+    for q in questions["queries"]:
+        qid = q["id"]
+        g = grep[qid]
+        x = es[qid]
+        key = answers[qid]
+        g_paths = g["matchedFiles"]
+        g_texts = [h["text"] for h in g["hits"]] + g_paths
+        x_paths = [rel_path(h.get("path")) or (h.get("title") or "") for h in x["hits"]]
+        x_texts = [(h.get("text") or "") for h in x["hits"]]
+        g_score = score(g_texts, g_paths, key)
+        x_score = score(x_texts, x_paths, key)
+        ratio = None
+        if x["retrievedBytes"] and g["retrievedBytes"]:
+            ratio = round(g["retrievedBytes"] / x["retrievedBytes"], 2)
+        items.append(
+            {
+                "id": qid,
+                "label": q["label"],
+                "question": q["question"],
+                "groundTruth": key["answer"],
+                "preferredFiles": key.get("preferredFiles") or [],
+                "grep": {
+                    "hits": g["hits"][:12],
+                    "hitCount": g["hitCount"],
+                    "matchedFiles": g["matchedFiles"],
+                    "retrievedBytes": g["retrievedBytes"],
+                    "retrievedTokensEst": g["retrievedTokensEst"],
+                    "filesScanned": g["filesScanned"],
+                    "bytesScanned": g["bytesScanned"],
+                    "note": g.get("note"),
+                    "correctness": g_score,
+                },
+                "xerj": {
+                    "hits": [
+                        {
+                            "path": rel_path(h.get("path")),
+                            "title": h.get("title"),
+                            "page": h.get("page"),
+                            "score": h.get("score"),
+                            "index": h.get("index"),
+                            "format": h.get("format"),
+                            "text": h.get("text"),
+                            "passage": h.get("passage"),
+                        }
+                        for h in x["hits"]
+                    ],
+                    "tookMs": x.get("took"),
+                    "total": x.get("total"),
+                    "retrievedBytes": x["retrievedBytes"],
+                    "retrievedTokensEst": x["retrievedTokensEst"],
+                    "savings": x.get("savings"),
+                    "hints": x.get("hints"),
+                    "correctness": x_score,
+                    "cli": {
+                        "exitCode": cli[qid]["exitCode"],
+                        "stderr": (cli[qid].get("stderr") or "")[:500],
+                        "note": cli[qid].get("note"),
+                    },
+                },
+                "byteRatioGrepOverXerj": ratio,
+            }
+        )
+
+    demo = {
+        "mode": "fixture",
+        "title": "Lumin Sign · corpus search desk",
+        "library": {
+            "name": "XERJ",
+            "url": "https://github.com/xerj-org/xerj",
+            "license": "Apache-2.0",
+            "version": meta.get("xerjVersion"),
+        },
+        "meta": meta,
+        "gain": {"json": gain, "text": gain_text},
+        "questions": items,
+        "caveat": "XERJ's own case study: retrieval wins on private, internal, niche, or post-cutoff material, and is neutral to harmful on popular public libraries the model already knows. This desk is a private fixture corpus.",
+        "pageindexNote": "Question “Liability cap (long MSA)” uses the same Lumin Sign × Acme Holdings article style as apps/pageindex-contract-qa (PR #12). PageIndex walks a TOC tree to Article 10 → 10.2.1. XERJ ranks passages across the mixed corpus; Harbor MSA liability pages can outrank 10.2.1 because they also say “cap”. That is a real ranking result, not a gamed one.",
+    }
+    (F / "demo.json").write_text(json.dumps(demo, indent=2) + "\n")
+    print("wrote", F / "demo.json")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/apps/xerj-esign-search/scripts/capture.py b/apps/xerj-esign-search/scripts/capture.py
new file mode 100644
index 0000000..178df3b
--- /dev/null
+++ b/apps/xerj-esign-search/scripts/capture.py
@@ -0,0 +1,257 @@
+#!/usr/bin/env python3
+"""Capture grep baseline + live XERJ search/gain into fixtures/ (no secrets)."""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import time
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+CORPUS = ROOT / "corpus"
+FIXTURES = ROOT / "fixtures"
+XERJ = os.environ.get("XERJ_BIN", str(Path.home() / ".local/bin/xerj"))
+URL = os.environ.get("XERJ_URL", "http://127.0.0.1:19200")
+PREFIX = "esign"
+
+
+def run(cmd: list[str], timeout: int = 60) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
+
+
+def grep_hits(patterns: list[str]) -> dict:
+    hits = []
+    files_scanned = 0
+    bytes_scanned = 0
+    matched_files: set[str] = set()
+    for path in sorted(CORPUS.rglob("*")):
+        if not path.is_file():
+            continue
+        files_scanned += 1
+        raw = path.read_bytes()
+        bytes_scanned += len(raw)
+        try:
+            text = raw.decode("utf-8")
+        except UnicodeDecodeError:
+            # PDFs: extract printable strings so grep has a fair text baseline
+            text = "".join(chr(b) if 32 <= b < 127 else "\n" for b in raw)
+        rel = str(path.relative_to(CORPUS))
+        file_bytes = path.stat().st_size
+        for i, line in enumerate(text.splitlines(), start=1):
+            if any(p.lower() in line.lower() for p in patterns):
+                matched_files.add(rel)
+                snippet = line.strip()
+                if len(snippet) > 280:
+                    snippet = snippet[:277] + "..."
+                hits.append(
+                    {
+                        "path": rel,
+                        "line": i,
+                        "text": snippet,
+                    }
+                )
+    # Token model used for the demo: grep-driven agent reads whole matching files
+    # (XERJ README: "a grep hit is a line, and judging that line means opening the whole file").
+    retrieved_bytes = 0
+    for rel in matched_files:
+        retrieved_bytes += (CORPUS / rel).stat().st_size
+    return {
+        "hits": hits[:40],
+        "hitCount": len(hits),
+        "matchedFiles": sorted(matched_files),
+        "filesScanned": files_scanned,
+        "bytesScanned": bytes_scanned,
+        "retrievedBytes": retrieved_bytes,
+        "retrievedTokensEst": retrieved_bytes // 4,
+        "note": "Grep baseline is a case-insensitive substring scan of the corpus. Token/byte cost assumes a grep-driven agent then opens every matching file (XERJ README).",
+    }
+
+
+def xerj_search(query: str) -> dict:
+    # `xerj search` is the definition-first code client (match_phrase on `defs`).
+    # Document/PDF indices created by autoindex do not have `defs`, so the CLI
+    # 400s under strict_unknown_fields. Capture that honestly; ranked passages
+    # for this corpus come from the documented ES `_search` + `_passage` path.
+    cmd = [
+        XERJ,
+        "search",
+        "--url",
+        URL,
+        "--prefix",
+        PREFIX,
+        "-k",
+        "5",
+        "--full",
+        "800",
+        "--json",
+        query,
+    ]
+    proc = run(cmd)
+    raw_out = proc.stdout
+    raw_err = proc.stderr
+    parsed = None
+    if raw_out.strip():
+        try:
+            parsed = json.loads(raw_out)
+        except json.JSONDecodeError:
+            parsed = None
+    return {
+        "command": cmd,
+        "exitCode": proc.returncode,
+        "stdout": raw_out,
+        "stderr": raw_err,
+        "parsed": parsed,
+        "note": "xerj search targets defs/name (code). This docs/PDF corpus has body/title/text only, so the CLI returns HTTP 400. See xerj-es-passages.json for the working ES _search + _passage capture.",
+    }
+
+
+def es_passage_search(query: str) -> dict:
+    import urllib.request
+
+    body = {
+        "size": 5,
+        "query": {
+            "bool": {
+                "should": [
+                    {
+                        "multi_match": {
+                            "query": query,
+                            "fields": ["body", "title", "text"],
+                            "type": "best_fields",
+                        }
+                    },
+                    {"match_phrase": {"body": {"query": query, "boost": 2}}},
+                ]
+            }
+        },
+        "_source": ["ax_path", "title", "page", "ax_format"],
+        "fields": ["_passage"],
+        "highlight": {"fields": {"body": {"fragment_size": 240, "number_of_fragments": 1}}},
+    }
+    req = urllib.request.Request(
+        f"{URL}/{PREFIX}-*/_search",
+        data=json.dumps(body).encode("utf-8"),
+        headers={"content-type": "application/json"},
+        method="POST",
+    )
+    with urllib.request.urlopen(req, timeout=30) as resp:
+        payload = json.loads(resp.read().decode("utf-8"))
+    hits = []
+    retrieved_bytes = 0
+    for h in payload.get("hits", {}).get("hits", []):
+        src = h.get("_source") or {}
+        passage = None
+        fields = h.get("fields") or {}
+        p_field = fields.get("_passage")
+        if isinstance(p_field, list) and p_field:
+            passage = p_field[0]
+        elif isinstance(p_field, dict):
+            passage = p_field
+        text = ""
+        if isinstance(passage, dict):
+            text = passage.get("text") or ""
+        if not text:
+            hl = h.get("highlight", {}).get("body") or []
+            text = hl[0] if hl else ""
+        retrieved_bytes += len(text.encode("utf-8"))
+        hits.append(
+            {
+                "index": h.get("_index"),
+                "score": h.get("_score"),
+                "path": src.get("ax_path"),
+                "title": src.get("title"),
+                "page": src.get("page"),
+                "format": src.get("ax_format"),
+                "passage": passage,
+                "text": text,
+                "highlight": (h.get("highlight") or {}).get("body"),
+            }
+        )
+    savings = payload.get("_savings")
+    return {
+        "request": body,
+        "took": payload.get("took"),
+        "total": payload.get("hits", {}).get("total"),
+        "hits": hits,
+        "retrievedBytes": retrieved_bytes,
+        "retrievedTokensEst": retrieved_bytes // 4,
+        "savings": savings,
+        "hints": payload.get("_xerj"),
+    }
+
+
+def xerj_gain() -> dict:
+    proc = run([XERJ, "gain", "--url", URL, "--json"])
+    parsed = None
+    if proc.stdout.strip():
+        try:
+            parsed = json.loads(proc.stdout)
+        except json.JSONDecodeError:
+            parsed = None
+    text = run([XERJ, "gain", "--url", URL])
+    return {
+        "json": parsed,
+        "jsonStdout": proc.stdout,
+        "jsonStderr": proc.stderr,
+        "textStdout": text.stdout,
+        "textStderr": text.stderr,
+    }
+
+
+def init_dry_run() -> dict:
+    proc = run([XERJ, "init", "--url", URL, "--dry-run"], timeout=20)
+    return {"stdout": proc.stdout, "stderr": proc.stderr, "exitCode": proc.returncode}
+
+
+def main() -> None:
+    questions = json.loads((FIXTURES / "questions.json").read_text())
+    answers = json.loads((FIXTURES / "answers.json").read_text())
+    grep_out = {}
+    xerj_cli = {}
+    xerj_es = {}
+    for q in questions["queries"]:
+        print("query", q["id"])
+        grep_out[q["id"]] = grep_hits(q["grepPatterns"])
+        xerj_cli[q["id"]] = xerj_search(q["xerjSearch"])
+        xerj_es[q["id"]] = es_passage_search(q["xerjSearch"])
+        time.sleep(0.05)
+
+    gain = xerj_gain()
+    init = init_dry_run()
+
+    (FIXTURES / "grep-results.json").write_text(json.dumps(grep_out, indent=2) + "\n")
+    (FIXTURES / "xerj-search.json").write_text(json.dumps(xerj_cli, indent=2) + "\n")
+    (FIXTURES / "xerj-es-passages.json").write_text(json.dumps(xerj_es, indent=2) + "\n")
+    (FIXTURES / "xerj-gain.json").write_text(json.dumps(gain.get("json"), indent=2) + "\n")
+    (FIXTURES / "xerj-gain.txt").write_text(gain.get("textStdout") or gain.get("jsonStdout") or "")
+    (FIXTURES / "xerj-init-dry-run.txt").write_text((init.get("stdout") or "") + (init.get("stderr") or ""))
+    meta = {
