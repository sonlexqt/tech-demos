# Copy to .env for LIVE MODE. Leave unset (or omit .env) for MOCK MODE.
# Never commit .env or real secrets.

# From Box Developer Console → your OAuth 2.0 Platform App → Configuration
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=

# Must exactly match a Redirect URI configured on the app.
# Local standard OAuth callback:
BOX_REDIRECT_URI=http://localhost:5173/api/auth/callback

# Optional override of the Web App Integration callback shown in docs.
# BOX_OPEN_WITH_CALLBACK=http://localhost:5173/open-with
