{
  "name": "box-open-with-lumin",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "start": "LUMIN_STATIC=dist bun run src/server/index.ts",
    "test": "bun test tests",
    "capture": "bun run scripts/capture.ts",
    "pages:dev": "bun run build && wrangler pages dev dist --compatibility-date=2024-11-06",
    "pages:deploy": "bun run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "box-node-sdk": "^10.3.0",
    "hono": "^4.10.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "puppeteer-core": "^25.18.1",
    "typescript": "~5.7.3",
    "vite": "^6.4.1",
    "wrangler": "^4.45.0"
  }
}
