# Optional path to a clone of https://github.com/greydanus/pengpt
# (needed for photo→style via inference/hand.py, and for style-fit from a stroke file).
PENGPT_DIR=

# Packed handwriting weights. If missing, pen.py downloads them from the
# greydanus/pengpt GitHub release models-2026-11-16 (hand.npz, ~6 MB).
PENGPT_MODEL=hand.npz

# Only required for photo → style vector (hand.py uses Claude to read words).
# Never commit the real key.
ANTHROPIC_API_KEY=
