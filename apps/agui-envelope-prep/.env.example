# Live mode only. Never required for `bun run dev` (defaults to MOCK) or CI.
GEMINI_API_KEY=

# Primary model, then fallback on 404/unavailable. 429/503 retry with backoff.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# mock | live — UI can still override per run.
AGUI_MODE=mock

# Mock stream pacing in milliseconds (0 for tests / eval).
AGUI_MOCK_DELAY_MS=90

PORT=8787
