{
  "name": "agui-envelope-prep",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "start": "AGUI_STATIC=dist bun run src/server/index.ts",
    "test": "AGUI_MOCK_DELAY_MS=0 bun test tests",
    "eval": "bun run src/eval/run-eval.ts --mode live",
    "eval:mock": "bun run src/eval/run-eval.ts --mode mock",
    "generate:fixture": "bun run fixture/generate-pdf.ts",
    "capture": "bun run scripts/capture.ts"
  },
  "dependencies": {
    "@ag-ui/client": "^1.0.4",
    "@ag-ui/core": "^1.0.4",
    "@ag-ui/encoder": "^1.0.4",
    "@google/genai": "^1.30.0",
    "fast-json-patch": "^3.1.1",
    "hono": "^4.10.6",
    "pdfjs-dist": "^4.10.38",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "pdf-lib": "^1.17.1",
    "puppeteer-core": "^24.29.1",
    "typescript": "~5.7.3",
    "vite": "^6.4.1"
  }
}
