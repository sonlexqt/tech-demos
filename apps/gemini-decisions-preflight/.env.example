# Placeholder only. Never commit a real key.
# Copy to .env in this directory if you run a live eval locally.
GEMINI_API_KEY=your-gemini-api-key-here

# mock | live | auto (default auto: live when GEMINI_API_KEY is set, else mock)
DECISIONS_MODE=auto

# Generative baseline for `npm run eval` (structured JSON). Default is gemini-3.5-flash-lite
# because gemini-3.5-flash and newer Flash ids returned 503 high-demand on the owner key.
GENERATIVE_MODEL=gemini-3.5-flash-lite

# Optional: override Flash-family USD / 1M token rates used in SUMMARY cost columns.
# FLASH_INPUT_USD_PER_M=0.30
# FLASH_OUTPUT_USD_PER_M=2.50
