# Server-side only (never use a VITE_ prefix; the browser never sees this).
# First non-empty key wins: JEV_API_KEY → JEV_AI_GATEWAY_API_KEY → AI_GATEWAY_API_KEY
JEV_API_KEY=

# Optional TypeSafe-compatible gateways (used when JEV_API_KEY is empty):
# JEV_AI_GATEWAY_API_KEY=
# AI_GATEWAY_API_KEY=

# Optional overrides:
# JEV_MODEL=jev-latest
# JEV_BASE_URL=https://api.typesafe.ai/v1/systemone

# Optional OpenAI-compatible helper for TYPE_TEXT (same role as jev-ultrafast TEXT_MODEL_*):
# TEXT_MODEL_API_KEY=
# TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
# TEXT_MODEL=inception/mercury-2.5
# TEXT_MODEL_REASONING=none
