# Server-side only (never use a VITE_ prefix; the browser never sees this).
# When unset, the demo uses deterministic fixture ranking.
# Copy to .env locally if you want live TypeSafe Jev scoring.
#
# JEV_API_KEY=
#
# Optional overrides:
# JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=jev-latest
